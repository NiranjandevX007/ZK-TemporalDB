# ══════════════════════════════════════════════════════════════════════════════
# ZK-TemporalDB — Person 2 Environment Variables
# Copy this file to .env and fill in your local credentials.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string for the academic records database.
# Format: postgresql://user:password@host:port/database
POSTGRES_URI=postgresql://your_user:your_password@localhost:5432/zk_temporaldb

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string for the document store (snapshots, proofs).
# Format: mongodb://user:password@host:port/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=zk_temporaldb

# ── ZKP Settings (optional) ──────────────────────────────────────────────────
# Integer scale factor for CGPA in ZKP circuits (100 = two decimal places)
ZKP_CGPA_SCALE=100
